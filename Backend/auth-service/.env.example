PORT=5000
# عنوان MongoDB (مع اسم المستخدم وكلمة المرور إن وُجدت)
MONGO_URI=mongodb://localhost:27017/auth_db
# مفتاح توقيع JWT: يجب أن يكون نفس القيمة في الخدمات الثلاث
# لتوليد مفتاح قوي:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
